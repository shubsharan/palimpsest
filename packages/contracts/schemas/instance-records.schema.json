{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.invalid/contracts/instance-records/1",
  "title": "Offline Harness Instance Records",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "artifact": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/artifactReference"
    },
    "base": {
      "type": "object",
      "required": ["schemaVersion", "contractId"],
      "properties": {
        "schemaVersion": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
        },
        "contractId": {
          "type": "string"
        }
      }
    },
    "instanceBuildRequest": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractId",
        "requestId",
        "source",
        "seedCommitment",
        "agentCount"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
        },
        "contractId": { "const": "instance-build-request" },
        "requestId": { "$ref": "#/$defs/id" },
        "source": { "$ref": "#/$defs/artifact" },
        "seedCommitment": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/sha256"
        },
        "agentCount": { "const": 3 }
      },
      "additionalProperties": false
    },
    "publicInstanceManifest": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractId",
        "instanceId",
        "profileId",
        "tokenCount",
        "publicArtifacts"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
        },
        "contractId": { "const": "public-instance-manifest" },
        "instanceId": { "$ref": "#/$defs/id" },
        "profileId": { "$ref": "#/$defs/id" },
        "tokenCount": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/nonNegativeSafeInteger"
        },
        "publicArtifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/artifact" }
        }
      },
      "additionalProperties": false
    },
    "oracleManifest": {
      "type": "object",
      "required": ["schemaVersion", "contractId", "instanceId", "target", "privateArtifacts"],
      "properties": {
        "schemaVersion": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
        },
        "contractId": { "const": "oracle-manifest" },
        "instanceId": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/artifact" },
        "privateArtifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/artifact" }
        }
      },
      "additionalProperties": false
    },
    "agentReferenceCorpusManifest": {
      "type": "object",
      "required": ["schemaVersion", "contractId", "corpusId", "artifacts"],
      "properties": {
        "schemaVersion": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
        },
        "contractId": { "const": "agent-reference-corpus-manifest" },
        "corpusId": { "$ref": "#/$defs/id" },
        "artifacts": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/artifact" }
        }
      },
      "additionalProperties": false
    },
    "shardManifest": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractId",
        "instanceId",
        "agentId",
        "chapterIndexes",
        "cipherText"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
        },
        "contractId": { "const": "shard-manifest" },
        "instanceId": { "$ref": "#/$defs/id" },
        "agentId": { "enum": ["agent-1", "agent-2", "agent-3"] },
        "chapterIndexes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        },
        "cipherText": { "$ref": "#/$defs/artifact" }
      },
      "additionalProperties": false
    },
    "releasedShardManifest": {
      "type": "object",
      "required": ["schemaVersion", "contractId", "runId", "agentId", "revealOrdinal", "chapters"],
      "properties": {
        "schemaVersion": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
        },
        "contractId": { "const": "released-shard-manifest" },
        "runId": { "$ref": "#/$defs/id" },
        "agentId": { "enum": ["agent-1", "agent-2", "agent-3"] },
        "revealOrdinal": { "type": "integer", "minimum": 1 },
        "chapters": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        }
      },
      "additionalProperties": false
    },
    "difficultyConfig": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractId",
        "profileId",
        "communicationBudgetBytes",
        "switchCount"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
        },
        "contractId": { "const": "difficulty-config" },
        "profileId": { "$ref": "#/$defs/id" },
        "communicationBudgetBytes": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/nonNegativeSafeInteger"
        },
        "switchCount": { "type": "integer", "minimum": 0, "maximum": 16 }
      },
      "additionalProperties": false
    },
    "scoringPolicy": {
      "type": "object",
      "required": ["schemaVersion", "contractId", "policyId", "metricIds"],
      "properties": {
        "schemaVersion": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
        },
        "contractId": { "const": "scoring-policy" },
        "policyId": { "$ref": "#/$defs/id" },
        "metricIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      },
      "additionalProperties": false
    }
  }
}
