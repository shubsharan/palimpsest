{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.invalid/contracts/gate-report/1",
  "title": "Gate Report",
  "oneOf": [
    {
      "$ref": "#/$defs/predeclared"
    },
    {
      "$ref": "#/$defs/completed"
    }
  ],
  "$defs": {
    "threshold": {
      "type": "object",
      "required": ["name", "metric", "operator", "value", "unit"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "metric": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "operator": {
          "type": "string",
          "enum": ["lt", "lte", "eq", "gte", "gt"]
        },
        "value": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "criteria": {
      "type": "object",
      "required": ["pass", "rework", "stop"],
      "properties": {
        "pass": {
          "type": "string",
          "minLength": 1
        },
        "rework": {
          "type": "string",
          "minLength": 1
        },
        "stop": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "analysis": {
      "type": "object",
      "required": ["summary", "metrics"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "value", "unit"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "predeclared": {
      "type": "object",
      "required": [
        "schemaVersion",
        "state",
        "gateId",
        "question",
        "frozenInputs",
        "thresholds",
        "criteria",
        "predeclarationDigest"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
        },
        "state": {
          "type": "string",
          "const": "predeclared"
        },
        "gateId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "frozenInputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/artifactReference"
          }
        },
        "thresholds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://palimpsest.invalid/contracts/gate-report/1#/$defs/threshold"
          }
        },
        "criteria": {
          "$ref": "https://palimpsest.invalid/contracts/gate-report/1#/$defs/criteria"
        },
        "predeclarationDigest": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "completed": {
      "type": "object",
      "required": [
        "schemaVersion",
        "state",
        "gateId",
        "question",
        "frozenInputs",
        "thresholds",
        "criteria",
        "predeclarationDigest",
        "environment",
        "producerVersions",
        "rawArtifacts",
        "analysis",
        "result",
        "followUp"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
        },
        "state": {
          "type": "string",
          "const": "completed"
        },
        "gateId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "frozenInputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/artifactReference"
          }
        },
        "thresholds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://palimpsest.invalid/contracts/gate-report/1#/$defs/threshold"
          }
        },
        "criteria": {
          "$ref": "https://palimpsest.invalid/contracts/gate-report/1#/$defs/criteria"
        },
        "predeclarationDigest": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/sha256"
        },
        "environment": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/environment"
        },
        "producerVersions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/producer"
          }
        },
        "rawArtifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/artifactReference"
          }
        },
        "analysis": {
          "$ref": "https://palimpsest.invalid/contracts/gate-report/1#/$defs/analysis"
        },
        "result": {
          "type": "string",
          "enum": ["pass", "rework", "stop"]
        },
        "followUp": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
