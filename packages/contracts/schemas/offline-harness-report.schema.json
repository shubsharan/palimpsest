{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.invalid/contracts/offline-harness-report/1",
  "title": "Offline Harness Completion Report",
  "type": "object",
  "required": [
    "schemaVersion",
    "contractId",
    "state",
    "declarationDigest",
    "runId",
    "result",
    "completedStages",
    "externalModelRequestCount",
    "liveModelValidationAuthorized",
    "empiricalModelEvidence"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
    },
    "contractId": { "const": "offline-harness-report" },
    "state": { "enum": ["predeclared", "completed"] },
    "declarationDigest": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/sha256"
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "result": { "enum": ["pending", "pass", "rework", "invalid"] },
    "completedStages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "build",
          "launch",
          "reveal",
          "collaborate",
          "freeze",
          "submit",
          "clean-execute",
          "score",
          "replay",
          "redact"
        ]
      }
    },
    "externalModelRequestCount": { "type": "integer", "const": 0 },
    "liveModelValidationAuthorized": { "type": "boolean" },
    "empiricalModelEvidence": { "const": false }
  },
  "allOf": [
    {
      "if": {
        "properties": { "result": { "const": "pass" } },
        "required": ["result"]
      },
      "then": {
        "properties": {
          "state": { "const": "completed" },
          "completedStages": { "type": "array", "minItems": 10, "maxItems": 10 },
          "liveModelValidationAuthorized": { "type": "boolean", "const": true }
        }
      },
      "else": {
        "properties": {
          "liveModelValidationAuthorized": { "type": "boolean", "const": false }
        }
      }
    }
  ],
  "additionalProperties": false
}
