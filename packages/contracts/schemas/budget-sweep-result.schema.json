{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.invalid/contracts/budget-sweep-result/1",
  "title": "Gate A Budget Sweep Result",
  "type": "object",
  "required": [
    "schemaVersion",
    "contractId",
    "geometryId",
    "points",
    "passingIntervals",
    "minimumAdjacentPassingPoints"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
    },
    "contractId": {
      "type": "string",
      "const": "budget-sweep-result"
    },
    "geometryId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 61,
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "passingIntervals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interval"
      }
    },
    "minimumAdjacentPassingPoints": {
      "type": "integer",
      "const": 3
    }
  },
  "additionalProperties": false,
  "$defs": {
    "point": {
      "type": "object",
      "required": [
        "budgetBytes",
        "maximumUsefulCharge",
        "minimumRelayCharge",
        "relayCapacityCreditBytes",
        "usefulFits",
        "relayBlocked",
        "classification"
      ],
      "properties": {
        "budgetBytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 65536,
          "multipleOf": 1024
        },
        "maximumUsefulCharge": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/decimalInteger"
        },
        "minimumRelayCharge": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/decimalInteger"
        },
        "relayCapacityCreditBytes": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/decimalInteger"
        },
        "usefulFits": {
          "type": "boolean"
        },
        "relayBlocked": {
          "type": "boolean"
        },
        "classification": {
          "type": "string",
          "enum": ["pass", "fail"]
        }
      },
      "additionalProperties": false
    },
    "interval": {
      "type": "object",
      "required": ["minimumBudgetBytes", "maximumBudgetBytes", "pointCount"],
      "properties": {
        "minimumBudgetBytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 65536
        },
        "maximumBudgetBytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 65536
        },
        "pointCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 61
        }
      },
      "additionalProperties": false
    }
  }
}
