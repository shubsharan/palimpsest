{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.invalid/contracts/useful-state-checkpoint/1",
  "title": "Gate A Useful-State Checkpoint",
  "type": "object",
  "required": [
    "schemaVersion",
    "contractId",
    "checkpointId",
    "version",
    "previousCheckpointSha256",
    "mappingHypotheses",
    "contradictions",
    "switchHypotheses",
    "reconstructionDiffs"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
    },
    "contractId": {
      "type": "string",
      "const": "useful-state-checkpoint"
    },
    "checkpointId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "previousCheckpointSha256": {
      "oneOf": [
        {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "mappingHypotheses": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/mapping"
      }
    },
    "contradictions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/note"
      }
    },
    "switchHypotheses": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/note"
      }
    },
    "reconstructionDiffs": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/note"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "mapping": {
      "type": "object",
      "required": ["cipherToken", "plainToken", "confidence", "provenance"],
      "properties": {
        "cipherToken": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "plainToken": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "confidence": {
          "type": "string",
          "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"
        },
        "provenance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "additionalProperties": false
    },
    "note": {
      "type": "object",
      "required": ["id", "text", "provenance"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "provenance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "additionalProperties": false
    }
  }
}
