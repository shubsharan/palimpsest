{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.invalid/contracts/revision-instance/1",
  "title": "Gate C Revision Instance",
  "type": "object",
  "required": [
    "schemaVersion",
    "contractId",
    "instanceId",
    "profileId",
    "sourceId",
    "tokenCount",
    "switchAfterChapter",
    "switchWordOffset",
    "preSwitchTokenCount",
    "postSwitchTokenCount",
    "preparedText",
    "cipherText",
    "stationaryKey",
    "revisedKey",
    "changedEntries",
    "matchedControls"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
    },
    "contractId": { "const": "revision-instance" },
    "instanceId": { "$ref": "#/$defs/id" },
    "profileId": { "$ref": "#/$defs/id" },
    "sourceId": { "$ref": "#/$defs/id" },
    "tokenCount": { "type": "integer", "minimum": 20000 },
    "switchAfterChapter": { "type": "integer", "minimum": 0 },
    "switchWordOffset": { "type": "integer", "minimum": 10000 },
    "preSwitchTokenCount": { "type": "integer", "minimum": 10000 },
    "postSwitchTokenCount": { "type": "integer", "minimum": 10000 },
    "preparedText": { "$ref": "#/$defs/artifact" },
    "cipherText": { "$ref": "#/$defs/artifact" },
    "stationaryKey": { "$ref": "#/$defs/artifact" },
    "revisedKey": { "$ref": "#/$defs/artifact" },
    "changedEntries": { "$ref": "#/$defs/artifact" },
    "matchedControls": { "$ref": "#/$defs/artifact" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "artifact": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/artifactReference"
    }
  }
}
