{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.invalid/contracts/canonical-archive/1",
  "title": "Canonical Archive Input",
  "type": "object",
  "required": ["schemaVersion", "contractId", "entries"],
  "properties": {
    "schemaVersion": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
    },
    "contractId": {
      "type": "string",
      "const": "canonical-archive"
    },
    "entries": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/fileEntry"
          },
          {
            "$ref": "#/$defs/directoryEntry"
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "fileEntry": {
      "type": "object",
      "required": ["path", "kind", "contentBase64"],
      "properties": {
        "path": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/safePath"
        },
        "kind": {
          "type": "string",
          "const": "file"
        },
        "contentBase64": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      },
      "additionalProperties": false
    },
    "directoryEntry": {
      "type": "object",
      "required": ["path", "kind"],
      "properties": {
        "path": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/safePath"
        },
        "kind": {
          "type": "string",
          "const": "directory"
        }
      },
      "additionalProperties": false
    }
  }
}
