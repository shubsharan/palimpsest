{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.invalid/contracts/logical-git-transaction/1",
  "title": "Logical Git Transaction",
  "type": "object",
  "required": [
    "schemaVersion",
    "contractId",
    "authenticatedAgent",
    "publicationSlot",
    "operation",
    "refName",
    "oldOid",
    "newOid",
    "slotStartJournalDigest",
    "objects"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
    },
    "contractId": {
      "type": "string",
      "const": "logical-git-transaction"
    },
    "authenticatedAgent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "publicationSlot": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "operation": {
      "type": "string",
      "enum": ["create", "update"]
    },
    "refName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "oldOid": {
      "$ref": "#/$defs/oid"
    },
    "newOid": {
      "$ref": "#/$defs/oid"
    },
    "slotStartJournalDigest": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/sha256"
    },
    "objects": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/object"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "oid": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "object": {
      "type": "object",
      "required": ["oid", "type", "contentBase64"],
      "properties": {
        "oid": {
          "$ref": "#/$defs/oid"
        },
        "type": {
          "type": "string",
          "enum": ["commit", "tree", "blob"]
        },
        "contentBase64": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      },
      "additionalProperties": false
    }
  }
}
