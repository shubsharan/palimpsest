{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.invalid/contracts/relay-attempt-result/1",
  "title": "Gate A Relay Attempt Result",
  "type": "object",
  "required": [
    "schemaVersion",
    "contractId",
    "attemptId",
    "fixtureId",
    "strategyId",
    "status",
    "accessedInputs",
    "transactions",
    "frameDigests",
    "frameBytes",
    "separateCapacityBits",
    "decodedOutput",
    "exactReconstruction",
    "failureCode"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
    },
    "contractId": {
      "type": "string",
      "const": "relay-attempt-result"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
    },
    "fixtureId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "strategyId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "status": {
      "type": "string",
      "enum": ["promoted", "failed-attack", "invalid"]
    },
    "accessedInputs": {
      "type": "array",
      "items": {
        "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/artifactReference"
      }
    },
    "transactions": {
      "type": "array",
      "items": {
        "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/artifactReference"
      }
    },
    "frameDigests": {
      "type": "array",
      "items": {
        "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/sha256"
      }
    },
    "frameBytes": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/decimalInteger"
    },
    "separateCapacityBits": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/decimalInteger"
    },
    "decodedOutput": {
      "oneOf": [
        {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/artifactReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "exactReconstruction": {
      "type": "boolean"
    },
    "failureCode": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
