{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.invalid/contracts/contract-envelope/1",
  "title": "Palimpsest Contract Envelope Definitions",
  "$defs": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "nonNegativeSafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "decimalInteger": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)$"
    },
    "hexSeed": {
      "type": "string",
      "pattern": "^(0|[1-9a-f][0-9a-f]*)$"
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*(?:^|/)\\.\\.?$)(?!.*//)(?!.*\\\\)[^\\u0000]+$"
    },
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["node", "pnpm", "python", "uv", "git", "platform", "revision"],
      "properties": {
        "node": {
          "type": "string",
          "const": "26.5.0"
        },
        "pnpm": {
          "type": "string",
          "const": "10.14.0"
        },
        "python": {
          "type": "string",
          "const": "3.12.4"
        },
        "uv": {
          "type": "string",
          "const": "0.11.14"
        },
        "git": {
          "type": "string",
          "const": "2.48.1"
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    },
    "artifactReference": {
      "type": "object",
      "required": ["artifactType", "sha256", "byteLength"],
      "properties": {
        "artifactType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byteLength": {
          "$ref": "#/$defs/nonNegativeSafeInteger"
        }
      },
      "additionalProperties": false
    },
    "outputEntry": {
      "type": "object",
      "required": ["path", "byteLength", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/safePath"
        },
        "byteLength": {
          "$ref": "#/$defs/nonNegativeSafeInteger"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  }
}
