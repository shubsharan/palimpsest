{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.invalid/contracts/artifact-response-manifest/1",
  "title": "Artifact Response Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "requestDigest",
    "producer",
    "environment",
    "immutableInputs",
    "outputs",
    "archive"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
    },
    "requestDigest": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/sha256"
    },
    "producer": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/producer"
    },
    "environment": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/environment"
    },
    "immutableInputs": {
      "type": "array",
      "items": {
        "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/artifactReference"
      }
    },
    "outputs": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/outputEntry"
      }
    },
    "archive": {
      "type": "object",
      "required": ["byteLength", "sha256"],
      "properties": {
        "byteLength": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/nonNegativeSafeInteger"
        },
        "sha256": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
