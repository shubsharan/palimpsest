{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.invalid/contracts/solver-checkpoint/1",
  "title": "Gate C Solver Checkpoint",
  "type": "object",
  "required": [
    "schemaVersion",
    "contractId",
    "attemptId",
    "ordinal",
    "revealOrdinal",
    "observedMonotonicMs",
    "responseId",
    "previousResponseId",
    "containerId",
    "mappings",
    "switchHypotheses",
    "reconstructionRefs",
    "usage"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
    },
    "contractId": { "const": "solver-checkpoint" },
    "attemptId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "ordinal": { "type": "integer", "minimum": 1 },
    "revealOrdinal": { "type": "integer", "minimum": 1 },
    "observedMonotonicMs": { "type": "integer", "minimum": 0 },
    "responseId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "previousResponseId": { "type": ["string", "null"], "minLength": 1, "maxLength": 256 },
    "containerId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "mappings": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/mapping" }
    },
    "switchHypotheses": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/switchHypothesis" }
    },
    "reconstructionRefs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/artifactReference"
      }
    },
    "usage": {
      "type": "object",
      "required": ["inputTokens", "outputTokens", "toolCalls"],
      "properties": {
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "toolCalls": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "mapping": {
      "type": "object",
      "required": [
        "cipherType",
        "plainType",
        "confidence",
        "status",
        "supportingRevealOrdinals",
        "rationale"
      ],
      "properties": {
        "cipherType": { "type": "string", "minLength": 1 },
        "plainType": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "enum": ["active", "retracted", "superseded"] },
        "supportingRevealOrdinals": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "rationale": { "type": "string", "maxLength": 2000 }
      },
      "additionalProperties": false
    },
    "switchHypothesis": {
      "type": "object",
      "required": ["afterChapter", "confidence", "evidence"],
      "properties": {
        "afterChapter": { "type": "integer", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "string", "maxLength": 4000 }
      },
      "additionalProperties": false
    }
  }
}
