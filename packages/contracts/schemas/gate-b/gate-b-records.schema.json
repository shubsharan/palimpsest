{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.invalid/contracts/gate-b-records/1",
  "title": "Gate B Contract Family",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,95}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "artifact": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/artifactReference"
    },
    "artifacts": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "pipelineVersions": {
      "type": "object",
      "required": ["strip", "normalization", "tokenization", "entities", "key", "rendering"],
      "properties": {
        "strip": {
          "$ref": "#/$defs/version"
        },
        "normalization": {
          "$ref": "#/$defs/version"
        },
        "tokenization": {
          "$ref": "#/$defs/version"
        },
        "entities": {
          "$ref": "#/$defs/version"
        },
        "key": {
          "$ref": "#/$defs/version"
        },
        "rendering": {
          "$ref": "#/$defs/version"
        }
      },
      "additionalProperties": false
    },
    "scoreSlices": {
      "type": "object",
      "required": [
        "tokenAccuracy",
        "unresolvedTokenMass",
        "macroTypeAccuracy",
        "weightedTokenAccuracy",
        "frequency",
        "classes",
        "ambiguity"
      ],
      "properties": {
        "tokenAccuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "unresolvedTokenMass": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "macroTypeAccuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "weightedTokenAccuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "frequency": {
          "type": "object",
          "patternProperties": {
            "^d(0[1-9]|10)$": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "classes": {
          "type": "object",
          "required": ["function", "content", "entity"],
          "properties": {
            "function": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "content": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "entity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "ambiguity": {
          "type": "object",
          "required": ["low", "medium", "high"],
          "properties": {
            "low": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "medium": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "high": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sourceRecord": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractId",
        "sourceId",
        "tier",
        "title",
        "author",
        "catalogUrl",
        "downloadUrl",
        "rights",
        "retrievedAt",
        "encoding",
        "stripProfile",
        "rawArtifact"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
        },
        "contractId": {
          "const": "gate-b-source-record"
        },
        "sourceId": {
          "$ref": "#/$defs/id"
        },
        "tier": {
          "const": "gutenberg"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "catalogUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "downloadUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "rights": {
          "type": "string",
          "minLength": 1
        },
        "retrievedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "encoding": {
          "const": "utf-8"
        },
        "stripProfile": {
          "$ref": "#/$defs/version"
        },
        "rawArtifact": {
          "$ref": "#/$defs/artifact"
        }
      },
      "additionalProperties": false
    },
    "buildRequest": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractId",
        "requestId",
        "instanceId",
        "source",
        "sourceRecord",
        "masterSeed",
        "targetTokenCount",
        "profileId",
        "pipelineVersions",
        "declaredOutputs"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "contractId": {
          "const": "gate-b-build-request"
        },
        "requestId": {
          "$ref": "#/$defs/id"
        },
        "instanceId": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/artifact"
        },
        "sourceRecord": {
          "$ref": "#/$defs/artifact"
        },
        "masterSeed": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "targetTokenCount": {
          "type": "integer",
          "const": 20000
        },
        "profileId": {
          "const": "stationary-render-safe-v1"
        },
        "pipelineVersions": {
          "$ref": "#/$defs/pipelineVersions"
        },
        "declaredOutputs": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/safePath"
          }
        }
      },
      "additionalProperties": false
    },
    "preparedPlaintextManifest": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractId",
        "instanceId",
        "tokenCount",
        "vocabularySize",
        "chapterCount",
        "pipelineVersions",
        "preparedText",
        "tokens",
        "vocabulary"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "contractId": {
          "const": "gate-b-prepared-plaintext-manifest"
        },
        "instanceId": {
          "$ref": "#/$defs/id"
        },
        "tokenCount": {
          "const": 20000
        },
        "vocabularySize": {
          "type": "integer",
          "minimum": 2
        },
        "chapterCount": {
          "type": "integer",
          "minimum": 1
        },
        "pipelineVersions": {
          "$ref": "#/$defs/pipelineVersions"
        },
        "preparedText": {
          "$ref": "#/$defs/artifact"
        },
        "tokens": {
          "$ref": "#/$defs/artifact"
        },
        "vocabulary": {
          "$ref": "#/$defs/artifact"
        }
      },
      "additionalProperties": false
    },
    "entityRegenerationMap": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractId",
        "instanceId",
        "proposalModel",
        "reviewPatch",
        "lexicon",
        "typeMapping",
        "entities",
        "collisionCount"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "contractId": {
          "const": "gate-b-entity-regeneration-map"
        },
        "instanceId": {
          "$ref": "#/$defs/id"
        },
        "proposalModel": {
          "$ref": "#/$defs/artifact"
        },
        "reviewPatch": {
          "$ref": "#/$defs/artifact"
        },
        "lexicon": {
          "$ref": "#/$defs/artifact"
        },
        "typeMapping": {
          "$ref": "#/$defs/artifact"
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["roleId", "entityClass", "aliases", "replacement"],
            "properties": {
              "roleId": {
                "$ref": "#/$defs/id"
              },
              "entityClass": {
                "enum": ["PERSON", "GPE", "LOC", "ORG", "FAC", "NORP", "EVENT", "WORK_OF_ART"]
              },
              "aliases": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "replacement": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "collisionCount": {
          "const": 0
        }
      },
      "additionalProperties": false
    },
    "publicInstanceManifest": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractId",
        "instanceId",
        "profileId",
        "tokenCount",
        "vocabularySize",
        "cipherView",
        "referenceCorpus",
        "publicScoringVersion",
        "allowedModels",
        "resourcePolicy"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "contractId": {
          "const": "gate-b-public-instance-manifest"
        },
        "instanceId": {
          "$ref": "#/$defs/id"
        },
        "profileId": {
          "const": "stationary-render-safe-v1"
        },
        "tokenCount": {
          "const": 20000
        },
        "vocabularySize": {
          "type": "integer",
          "minimum": 2
        },
        "cipherView": {
          "$ref": "#/$defs/artifact"
        },
        "referenceCorpus": {
          "$ref": "#/$defs/artifact"
        },
        "publicScoringVersion": {
          "$ref": "#/$defs/version"
        },
        "allowedModels": {
          "$ref": "#/$defs/artifacts"
        },
        "resourcePolicy": {
          "$ref": "#/$defs/artifact"
        }
      },
      "additionalProperties": false
    },
    "solverInputManifest": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractId",
        "instanceId",
        "condition",
        "publicManifest",
        "cipherView",
        "referenceCorpus",
        "instructions",
        "resourcePolicy"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "contractId": {
          "const": "gate-b-solver-input-manifest"
        },
        "instanceId": {
          "$ref": "#/$defs/id"
        },
        "condition": {
          "enum": ["mechanical", "frontier-agent-tools", "human-tools"]
        },
        "publicManifest": {
          "$ref": "#/$defs/artifact"
        },
        "cipherView": {
          "$ref": "#/$defs/artifact"
        },
        "referenceCorpus": {
          "$ref": "#/$defs/artifact"
        },
        "instructions": {
          "$ref": "#/$defs/artifact"
        },
        "resourcePolicy": {
          "$ref": "#/$defs/artifact"
        }
      },
      "additionalProperties": false
    },
    "oracleManifest": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractId",
        "instanceId",
        "sourceRecord",
        "preparedPlaintext",
        "tokenTruth",
        "encryptionKey",
        "recoveredMapping",
        "entityMap"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "contractId": {
          "const": "gate-b-oracle-manifest"
        },
        "instanceId": {
          "$ref": "#/$defs/id"
        },
        "sourceRecord": {
          "$ref": "#/$defs/artifact"
        },
        "preparedPlaintext": {
          "$ref": "#/$defs/artifact"
        },
        "tokenTruth": {
          "$ref": "#/$defs/artifact"
        },
        "encryptionKey": {
          "$ref": "#/$defs/artifact"
        },
        "recoveredMapping": {
          "$ref": "#/$defs/artifact"
        },
        "entityMap": {
          "$ref": "#/$defs/artifact"
        }
      },
      "additionalProperties": false
    },
    "referenceCorpusManifest": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractId",
        "snapshotId",
        "preprocessingVersion",
        "documents",
        "exclusionAudit"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "contractId": {
          "const": "gate-b-reference-corpus-manifest"
        },
        "snapshotId": {
          "$ref": "#/$defs/id"
        },
        "preprocessingVersion": {
          "$ref": "#/$defs/version"
        },
        "documents": {
          "$ref": "#/$defs/artifacts"
        },
        "exclusionAudit": {
          "$ref": "#/$defs/artifact"
        }
      },
      "additionalProperties": false
    },
    "baselineAttempt": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractId",
        "attemptId",
        "instanceId",
        "rung",
        "methodId",
        "inputs",
        "status",
        "wallSeconds",
        "outputs",
        "diagnostics"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "contractId": {
          "const": "gate-b-baseline-attempt"
        },
        "attemptId": {
          "$ref": "#/$defs/id"
        },
        "instanceId": {
          "$ref": "#/$defs/id"
        },
        "rung": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "methodId": {
          "$ref": "#/$defs/id"
        },
        "inputs": {
          "$ref": "#/$defs/artifacts"
        },
        "status": {
          "enum": ["success", "timeout", "failed", "invalid"]
        },
        "wallSeconds": {
          "type": "number",
          "minimum": 0
        },
        "outputs": {
          "$ref": "#/$defs/artifacts"
        },
        "diagnostics": {
          "$ref": "#/$defs/artifact"
        }
      },
      "additionalProperties": false
    },
    "identificationAttempt": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractId",
        "attemptId",
        "instanceId",
        "track",
        "inputs",
        "status",
        "candidates",
        "exactAlignedSource",
        "copiedReconstruction"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "contractId": {
          "const": "gate-b-identification-attempt"
        },
        "attemptId": {
          "$ref": "#/$defs/id"
        },
        "instanceId": {
          "$ref": "#/$defs/id"
        },
        "track": {
          "enum": [
            "cipher-view-canary",
            "raw-generation-canary",
            "direct-identification",
            "retrieval-alignment"
          ]
        },
        "inputs": {
          "$ref": "#/$defs/artifacts"
        },
        "status": {
          "enum": ["success", "no-identification", "timeout", "failed", "invalid"]
        },
        "candidates": {
          "$ref": "#/$defs/artifact"
        },
        "exactAlignedSource": {
          "type": "boolean"
        },
        "copiedReconstruction": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "solverCheckpoint": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractId",
        "checkpointId",
        "instanceId",
        "condition",
        "sequence",
        "trustedElapsedSeconds",
        "reconstruction",
        "mapping",
        "toolEvents",
        "identificationClaims",
        "usage"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "contractId": {
          "const": "gate-b-solver-checkpoint"
        },
        "checkpointId": {
          "$ref": "#/$defs/id"
        },
        "instanceId": {
          "$ref": "#/$defs/id"
        },
        "condition": {
          "enum": ["frontier-agent-tools", "human-tools"]
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "trustedElapsedSeconds": {
          "type": "number",
          "minimum": 0
        },
        "reconstruction": {
          "$ref": "#/$defs/artifact"
        },
        "mapping": {
          "$ref": "#/$defs/artifact"
        },
        "toolEvents": {
          "$ref": "#/$defs/artifact"
        },
        "identificationClaims": {
          "$ref": "#/$defs/artifact"
        },
        "usage": {
          "$ref": "#/$defs/artifact"
        }
      },
      "additionalProperties": false
    },
    "entityAudit": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractId",
        "auditId",
        "instanceId",
        "sample",
        "repeatedMentionConsistency",
        "missedEntityRate",
        "commonNounOverCaptureRate",
        "generatedNameCollisions"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "contractId": {
          "const": "gate-b-entity-audit"
        },
        "auditId": {
          "$ref": "#/$defs/id"
        },
        "instanceId": {
          "$ref": "#/$defs/id"
        },
        "sample": {
          "$ref": "#/$defs/artifact"
        },
        "repeatedMentionConsistency": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "missedEntityRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "commonNounOverCaptureRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "generatedNameCollisions": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "scoreTable": {
      "type": "object",
      "required": ["schemaVersion", "contractId", "scoringVersion", "rows"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "contractId": {
          "const": "gate-b-score-table"
        },
        "scoringVersion": {
          "$ref": "#/$defs/version"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rowId", "instanceId", "condition", "slices"],
            "properties": {
              "rowId": {
                "$ref": "#/$defs/id"
              },
              "instanceId": {
                "$ref": "#/$defs/id"
              },
              "condition": {
                "type": "string",
                "minLength": 1
              },
              "slices": {
                "$ref": "#/$defs/scoreSlices"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "decisionAnalysis": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractId",
        "instancePredicates",
        "designedResidual",
        "entityAcceptable",
        "integrityFailures",
        "classification"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "contractId": {
          "const": "gate-b-decision-analysis"
        },
        "instancePredicates": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "instanceId",
              "mechanicalHeadroom",
              "agentProgress",
              "humanProgress",
              "capableFloor",
              "recognitionSafe"
            ],
            "properties": {
              "instanceId": {
                "$ref": "#/$defs/id"
              },
              "mechanicalHeadroom": {
                "type": "boolean"
              },
              "agentProgress": {
                "type": "boolean"
              },
              "humanProgress": {
                "type": "boolean"
              },
              "capableFloor": {
                "type": "boolean"
              },
              "recognitionSafe": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "designedResidual": {
          "type": "boolean"
        },
        "entityAcceptable": {
          "type": "boolean"
        },
        "integrityFailures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "classification": {
          "enum": ["pass", "rework", "stop", "invalid"]
        }
      },
      "additionalProperties": false
    }
  }
}
