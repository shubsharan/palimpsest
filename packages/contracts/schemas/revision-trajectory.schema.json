{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.invalid/contracts/revision-trajectory/1",
  "title": "Gate C Revision Trajectory",
  "type": "object",
  "required": [
    "schemaVersion",
    "contractId",
    "attemptId",
    "checkpointScores",
    "preSwitchGainPp",
    "localizedDropPp",
    "changedRecoveryPp",
    "stableRetentionPp",
    "falseRetractionRate",
    "prematureAlarmCount",
    "detectionLatencyMs",
    "adaptationLatencyMs",
    "integrityFailures"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
    },
    "contractId": { "const": "revision-trajectory" },
    "attemptId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "checkpointScores": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/score" }
    },
    "preSwitchGainPp": { "type": "number", "minimum": -100, "maximum": 100 },
    "localizedDropPp": { "type": "number", "minimum": -100, "maximum": 100 },
    "changedRecoveryPp": { "type": "number", "minimum": -100, "maximum": 100 },
    "stableRetentionPp": { "type": "number", "minimum": -100, "maximum": 100 },
    "falseRetractionRate": { "type": "number", "minimum": 0, "maximum": 1 },
    "prematureAlarmCount": { "type": "integer", "minimum": 0 },
    "detectionLatencyMs": { "type": ["integer", "null"], "minimum": 0 },
    "adaptationLatencyMs": { "type": ["integer", "null"], "minimum": 0 },
    "integrityFailures": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "score": {
      "type": "object",
      "required": [
        "checkpointOrdinal",
        "revealOrdinal",
        "observedMonotonicMs",
        "changedAccuracy",
        "stableAccuracy"
      ],
      "properties": {
        "checkpointOrdinal": { "type": "integer", "minimum": 1 },
        "revealOrdinal": { "type": "integer", "minimum": 1 },
        "observedMonotonicMs": { "type": "integer", "minimum": 0 },
        "changedAccuracy": { "type": "number", "minimum": 0, "maximum": 1 },
        "stableAccuracy": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    }
  }
}
