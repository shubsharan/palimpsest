{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.invalid/contracts/git-genesis/1",
  "title": "Gate A Git Genesis",
  "type": "object",
  "required": [
    "schemaVersion",
    "contractId",
    "accountingVersion",
    "objectFormat",
    "publishedRefs",
    "everVisibleOids",
    "canonicalSha256"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
    },
    "contractId": {
      "type": "string",
      "const": "git-genesis"
    },
    "accountingVersion": {
      "type": "integer",
      "const": 1
    },
    "objectFormat": {
      "type": "string",
      "const": "sha256"
    },
    "publishedRefs": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/publishedRef"
      }
    },
    "everVisibleOids": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/oid"
      }
    },
    "canonicalSha256": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "oid": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "publishedRef": {
      "type": "object",
      "required": ["refName", "oid"],
      "properties": {
        "refName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^refs/heads/(main|agents/[a-z0-9-]+/[A-Za-z0-9._/-]+)$"
        },
        "oid": {
          "$ref": "#/$defs/oid"
        }
      },
      "additionalProperties": false
    }
  }
}
