{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.invalid/contracts/channel-fixture/1",
  "title": "Gate A Channel Fixture",
  "type": "object",
  "required": [
    "schemaVersion",
    "contractId",
    "fixtureId",
    "tokenCount",
    "vocabularySize",
    "source",
    "opaqueShard",
    "commonInputs",
    "normalizationVersion"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
    },
    "contractId": {
      "type": "string",
      "const": "channel-fixture"
    },
    "fixtureId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "tokenCount": {
      "type": "integer",
      "enum": [16384, 27000, 40960]
    },
    "vocabularySize": {
      "type": "integer",
      "enum": [4096, 8000, 12288]
    },
    "source": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/artifactReference"
    },
    "opaqueShard": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/artifactReference"
    },
    "commonInputs": {
      "type": "array",
      "items": {
        "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/artifactReference"
      }
    },
    "normalizationVersion": {
      "type": "string",
      "const": "1.0.0"
    }
  },
  "additionalProperties": false
}
