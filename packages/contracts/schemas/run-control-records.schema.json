{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.invalid/contracts/run-control-records/1",
  "title": "Offline Harness Run Control Records",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "digest": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/sha256"
    },
    "artifact": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/artifactReference"
    },
    "agentId": {
      "enum": ["agent-1", "agent-2", "agent-3"]
    },
    "runManifest": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractId",
        "runId",
        "declarationDigest",
        "instance",
        "adapterId",
        "agentIds",
        "accountingVersion",
        "communicationBudgetBytes"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
        },
        "contractId": { "const": "run-manifest" },
        "runId": { "$ref": "#/$defs/id" },
        "declarationDigest": { "$ref": "#/$defs/digest" },
        "instance": { "$ref": "#/$defs/artifact" },
        "adapterId": { "$ref": "#/$defs/id" },
        "agentIds": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/agentId" }
        },
        "accountingVersion": { "const": "GitAccountingFrameV1" },
        "communicationBudgetBytes": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/nonNegativeSafeInteger"
        }
      },
      "additionalProperties": false
    },
    "agentInvocation": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractId",
        "runId",
        "agentId",
        "invocationId",
        "adapterId",
        "lifecycleState",
        "monotonicDeadlineMs",
        "releasedInputManifest",
        "publishedSnapshotId"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
        },
        "contractId": { "const": "agent-invocation" },
        "runId": { "$ref": "#/$defs/id" },
        "agentId": { "$ref": "#/$defs/agentId" },
        "invocationId": { "$ref": "#/$defs/id" },
        "adapterId": { "$ref": "#/$defs/id" },
        "lifecycleState": {
          "enum": ["STARTING", "RUNNING", "FINALIZING"]
        },
        "monotonicDeadlineMs": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/nonNegativeSafeInteger"
        },
        "releasedInputManifest": { "$ref": "#/$defs/artifact" },
        "publishedSnapshotId": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "agentEvent": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractId",
        "runId",
        "agentId",
        "invocationId",
        "ordinal",
        "type",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
        },
        "contractId": { "const": "agent-event" },
        "runId": { "$ref": "#/$defs/id" },
        "agentId": { "$ref": "#/$defs/agentId" },
        "invocationId": { "$ref": "#/$defs/id" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "type": { "$ref": "#/$defs/id" },
        "payload": { "type": "object" }
      },
      "additionalProperties": false
    },
    "pushLedgerEntry": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractId",
        "runId",
        "agentId",
        "transactionId",
        "frameDigest",
        "chargeBytes",
        "budgetBefore",
        "budgetAfter",
        "result"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
        },
        "contractId": { "const": "push-ledger-entry" },
        "runId": { "$ref": "#/$defs/id" },
        "agentId": { "$ref": "#/$defs/agentId" },
        "transactionId": { "$ref": "#/$defs/id" },
        "frameDigest": { "$ref": "#/$defs/digest" },
        "chargeBytes": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/nonNegativeSafeInteger"
        },
        "budgetBefore": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/nonNegativeSafeInteger"
        },
        "budgetAfter": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/nonNegativeSafeInteger"
        },
        "result": { "enum": ["accepted", "rejected"] }
      },
      "additionalProperties": false
    },
    "publishedSnapshot": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractId",
        "runId",
        "snapshotId",
        "ordinal",
        "refMapDigest",
        "visibilityJournalDigest",
        "eventSequence"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
        },
        "contractId": { "const": "published-snapshot" },
        "runId": { "$ref": "#/$defs/id" },
        "snapshotId": { "$ref": "#/$defs/id" },
        "ordinal": { "type": "integer", "minimum": 0 },
        "refMapDigest": { "$ref": "#/$defs/digest" },
        "visibilityJournalDigest": { "$ref": "#/$defs/digest" },
        "eventSequence": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/nonNegativeSafeInteger"
        }
      },
      "additionalProperties": false
    },
    "runEvent": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractId",
        "runId",
        "sequence",
        "producer",
        "effectId",
        "eventType",
        "monotonicElapsedNs",
        "payload",
        "previousDigest",
        "digest"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
        },
        "contractId": { "const": "run-event" },
        "runId": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1 },
        "producer": { "$ref": "#/$defs/id" },
        "effectId": { "$ref": "#/$defs/id" },
        "eventType": { "$ref": "#/$defs/id" },
        "monotonicElapsedNs": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/decimalInteger"
        },
        "payload": { "type": "object" },
        "previousDigest": {
          "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
        },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "freezeSnapshot": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractId",
        "runId",
        "freezeId",
        "refMapDigest",
        "gitBundle",
        "visibilityJournalDigest",
        "ledgerDigest",
        "finalEventSequence",
        "eventChainHead"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
        },
        "contractId": { "const": "freeze-snapshot" },
        "runId": { "$ref": "#/$defs/id" },
        "freezeId": { "$ref": "#/$defs/id" },
        "refMapDigest": { "$ref": "#/$defs/digest" },
        "gitBundle": { "$ref": "#/$defs/artifact" },
        "visibilityJournalDigest": { "$ref": "#/$defs/digest" },
        "ledgerDigest": { "$ref": "#/$defs/digest" },
        "finalEventSequence": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/nonNegativeSafeInteger"
        },
        "eventChainHead": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "privateDeliverableManifest": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractId",
        "runId",
        "agentId",
        "freezeId",
        "releasedShardDigest",
        "outputs"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
        },
        "contractId": { "const": "private-deliverable-manifest" },
        "runId": { "$ref": "#/$defs/id" },
        "agentId": { "$ref": "#/$defs/agentId" },
        "freezeId": { "$ref": "#/$defs/id" },
        "releasedShardDigest": { "$ref": "#/$defs/digest" },
        "outputs": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/outputEntry"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
