{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.invalid/contracts/grading-records/1",
  "title": "Offline Harness Grading and Replay Records",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "digest": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/sha256"
    },
    "artifact": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/artifactReference"
    },
    "solverExecution": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractId",
        "runId",
        "executionId",
        "bundle",
        "networkDisabled",
        "exitCode",
        "outputs",
        "targetByteMatch"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
        },
        "contractId": { "const": "solver-execution" },
        "runId": { "$ref": "#/$defs/id" },
        "executionId": { "$ref": "#/$defs/id" },
        "bundle": { "$ref": "#/$defs/artifact" },
        "networkDisabled": { "const": true },
        "exitCode": { "type": "integer" },
        "outputs": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/outputEntry"
          }
        },
        "targetByteMatch": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "scoreReport": {
      "type": "object",
      "required": ["schemaVersion", "contractId", "runId", "policyId", "metrics"],
      "properties": {
        "schemaVersion": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
        },
        "contractId": { "const": "score-report" },
        "runId": { "$ref": "#/$defs/id" },
        "policyId": { "$ref": "#/$defs/id" },
        "metrics": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "number" }
        }
      },
      "additionalProperties": false
    },
    "trustedReplayBundle": {
      "type": "object",
      "required": ["schemaVersion", "contractId", "runId", "freezeId", "artifacts"],
      "properties": {
        "schemaVersion": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
        },
        "contractId": { "const": "trusted-replay-bundle" },
        "runId": { "$ref": "#/$defs/id" },
        "freezeId": { "$ref": "#/$defs/id" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/artifact" }
        }
      },
      "additionalProperties": false
    },
    "publicReportBundle": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractId",
        "runId",
        "replayDigest",
        "artifacts",
        "empiricalModelEvidence"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
        },
        "contractId": { "const": "public-report-bundle" },
        "runId": { "$ref": "#/$defs/id" },
        "replayDigest": { "$ref": "#/$defs/digest" },
        "artifacts": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "empiricalModelEvidence": { "const": false }
      },
      "additionalProperties": false
    }
  }
}
