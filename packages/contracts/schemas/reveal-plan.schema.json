{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.invalid/contracts/reveal-plan/1",
  "title": "Gate C Reveal Plan",
  "type": "object",
  "required": [
    "schemaVersion",
    "contractId",
    "instanceId",
    "clock",
    "intervalMs",
    "slots",
    "contradictionThreshold"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/schemaVersion"
    },
    "contractId": { "const": "reveal-plan" },
    "instanceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "clock": { "const": "monotonic" },
    "intervalMs": { "type": "integer", "minimum": 1 },
    "slots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/slot" }
    },
    "contradictionThreshold": {
      "type": "object",
      "required": ["changedOccurrenceFraction", "firstRevealOrdinal"],
      "properties": {
        "changedOccurrenceFraction": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "firstRevealOrdinal": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "slot": {
      "type": "object",
      "required": [
        "ordinal",
        "plannedOffsetMs",
        "chapterIndex",
        "tokenCount",
        "cumulativeTokenCount",
        "cipherChapterArtifact",
        "cumulativeChangedContradictionMass"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1 },
        "plannedOffsetMs": { "type": "integer", "minimum": 0 },
        "chapterIndex": { "type": "integer", "minimum": 0 },
        "tokenCount": { "type": "integer", "minimum": 1 },
        "cumulativeTokenCount": { "type": "integer", "minimum": 1 },
        "cipherChapterArtifact": {
          "$ref": "https://palimpsest.invalid/contracts/contract-envelope/1#/$defs/artifactReference"
        },
        "cumulativeChangedContradictionMass": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    }
  }
}
