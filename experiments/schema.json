{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.local/experiment.schema.json",
  "title": "Palimpsest Experiment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "models", "runs"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "name": { "$ref": "#/$defs/identifier" },
    "models": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/model" }
    },
    "runs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/run" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "duration": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:ms|s|m|h)$"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nonNegativeSafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": { "enum": ["openai", "anthropic", "google"] },
        "model": { "type": "string", "minLength": 1 },
        "reasoningEffort": { "enum": ["none", "minimal", "low", "medium", "high", "xhigh"] }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "agents",
        "model",
        "communication",
        "releases",
        "cutoff",
        "spendCeilingCents"
      ],
      "properties": {
        "source": { "type": "string", "pattern": "^fixtures/" },
        "agents": { "type": "integer", "minimum": 2, "maximum": 64 },
        "model": { "$ref": "#/$defs/identifier" },
        "communication": { "enum": ["shared", "isolated"] },
        "releases": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/duration" }
        },
        "cutoff": { "$ref": "#/$defs/duration" },
        "spendCeilingCents": { "$ref": "#/$defs/nonNegativeSafeInteger" },
        "rekeyAtStage": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        },
        "tokenLimitPerAgent": { "$ref": "#/$defs/safeInteger" },
        "checker": { "type": "boolean" }
      }
    }
  }
}
