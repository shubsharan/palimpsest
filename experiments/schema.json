{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.local/study.schema.json",
  "title": "Palimpsest Study",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "communication",
    "blocks",
    "assignment",
    "providers",
    "models",
    "schedule",
    "budgets",
    "orders",
    "checking",
    "scoring",
    "rubric",
    "adjustableFields",
    "failurePolicy"
  ],
  "properties": {
    "schemaVersion": { "const": 5 },
    "communication": { "$ref": "#/$defs/communication" },
    "blocks": { "$ref": "#/$defs/blocks" },
    "assignment": { "$ref": "#/$defs/assignment" },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/provider" }
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/model" }
    },
    "schedule": { "$ref": "#/$defs/schedule" },
    "budgets": { "$ref": "#/$defs/budgets" },
    "orders": { "$ref": "#/$defs/orders" },
    "checking": { "$ref": "#/$defs/checking" },
    "scoring": { "$ref": "#/$defs/scoring" },
    "rubric": { "$ref": "#/$defs/rubric" },
    "adjustableFields": {
      "type": "array",
      "prefixItems": [
        { "const": "budgets.tokenBudgetPerAgent" },
        { "const": "budgets.perAttemptMonetaryCeilingCents" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "failurePolicy": { "$ref": "#/$defs/failurePolicy" }
  },
  "$defs": {
    "communication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["teamChannel"],
      "properties": {
        "teamChannel": { "enum": ["enabled", "disabled"] }
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environmentName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "phase", "sourcePath"],
      "properties": {
        "blockId": { "$ref": "#/$defs/identifier" },
        "phase": { "enum": ["calibration", "validation"] },
        "sourcePath": { "type": "string", "minLength": 1 }
      }
    },
    "blocks": {
      "type": "array",
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/block" },
            {
              "type": "object",
              "properties": {
                "blockId": { "const": "calibration-odd-women" },
                "phase": { "const": "calibration" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/block" },
            {
              "type": "object",
              "properties": {
                "blockId": { "const": "validation-pointed-firs" },
                "phase": { "const": "validation" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/block" },
            {
              "type": "object",
              "properties": {
                "blockId": { "const": "validation-custom-country" },
                "phase": { "const": "validation" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/block" },
            {
              "type": "object",
              "properties": {
                "blockId": { "const": "validation-woodlanders" },
                "phase": { "const": "validation" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/block" },
            {
              "type": "object",
              "properties": {
                "blockId": { "const": "validation-silas-lapham" },
                "phase": { "const": "validation" }
              }
            }
          ]
        }
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    },
    "assignmentEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentId", "modelProfileId"],
      "properties": {
        "agentId": { "type": "string" },
        "modelProfileId": { "$ref": "#/$defs/identifier" }
      }
    },
    "assignment": {
      "type": "array",
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/assignmentEntry" },
            { "type": "object", "properties": { "agentId": { "const": "agent-1" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/assignmentEntry" },
            { "type": "object", "properties": { "agentId": { "const": "agent-2" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/assignmentEntry" },
            { "type": "object", "properties": { "agentId": { "const": "agent-3" } } }
          ]
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "conditionOrder": {
      "type": "array",
      "prefixItems": [
        { "enum": ["CS", "CR", "IS", "IR"] },
        { "enum": ["CS", "CR", "IS", "IR"] },
        { "enum": ["CS", "CR", "IS", "IR"] },
        { "enum": ["CS", "CR", "IS", "IR"] }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseOffsetsMs", "cutoffMs"],
      "properties": {
        "releaseOffsetsMs": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "minItems": 6,
          "maxItems": 6
        },
        "cutoffMs": { "type": "integer", "minimum": 1 }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokenBudgetPerAgent",
        "perAttemptMonetaryCeilingCents",
        "totalTokenCeiling",
        "totalMonetaryCeilingCents"
      ],
      "properties": {
        "tokenBudgetPerAgent": {
          "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "perAttemptMonetaryCeilingCents": { "type": "integer", "minimum": 0 },
        "totalTokenCeiling": {
          "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "totalMonetaryCeilingCents": { "type": "integer", "minimum": 0 }
      }
    },
    "orders": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calibration", "validation"],
      "properties": {
        "calibration": { "$ref": "#/$defs/conditionOrder" },
        "validation": {
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/conditionOrder" },
            { "$ref": "#/$defs/conditionOrder" },
            { "$ref": "#/$defs/conditionOrder" },
            { "$ref": "#/$defs/conditionOrder" }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "checking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feedbackId"],
      "properties": {
        "feedbackId": { "const": "published-runnability-coverage-v1" }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryMetricId", "diagnosticMetricId", "evaluationPolicyId"],
      "properties": {
        "primaryMetricId": { "const": "normalized-positional-word-v1" },
        "diagnosticMetricId": { "const": "palimpsest-diagnostics-v1" },
        "evaluationPolicyId": { "const": "all-canonical-main-snapshots-v1" }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rubricId", "path", "sha256"],
      "properties": {
        "rubricId": { "$ref": "#/$defs/identifier" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "failurePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stopOnInfrastructureFailure",
        "automaticRetry",
        "replacement",
        "eligibleClassification"
      ],
      "properties": {
        "stopOnInfrastructureFailure": { "const": true },
        "automaticRetry": { "const": false },
        "replacement": { "const": "explicit-appended" },
        "eligibleClassification": { "const": "session-infrastructure-error" }
      }
    },
    "provider": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["driver", "apiKeyEnv"],
          "properties": {
            "driver": { "enum": ["openai", "anthropic", "google"] },
            "apiKeyEnv": { "$ref": "#/$defs/environmentName" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["driver", "baseURL"],
          "properties": {
            "driver": { "const": "openai-compatible" },
            "baseURL": { "type": "string", "format": "uri" },
            "apiKeyEnv": { "$ref": "#/$defs/environmentName" },
            "headersEnv": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "$ref": "#/$defs/environmentName" }
            }
          }
        }
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": { "$ref": "#/$defs/identifier" },
        "model": { "type": "string", "minLength": 1 },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxOutputTokens": { "type": "integer", "minimum": 1 },
            "temperature": { "type": "number", "minimum": 0 },
            "topP": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "seed": { "type": "integer" }
          }
        },
        "providerOptions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
